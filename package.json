{
  "name": "mri-fivem-liquid-glass",
  "version": "1.1.0",
  "description": "Real liquid glass and game blur for FiveM NUI: blurs and refracts the live GTA V frame behind your HTML elements, where CSS backdrop-filter cannot see the game.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reference": {
      "types": "./dist/reference.d.ts",
      "import": "./dist/reference.js"
    },
    "./iife": "./dist/mri-liquid-glass.iife.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-iife.mjs",
    "docs:dev": "npm run build && node scripts/build-data.mjs && vitepress dev docs",
    "docs:build": "npm run build && node scripts/build-data.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "test": "node test/visual.mjs",
    "prepublishOnly": "npm run build",
    "validate": "node scripts/validate-registry.mjs"
  },
  "keywords": [
    "fivem",
    "redm",
    "cfx",
    "nui",
    "liquid-glass",
    "glassmorphism",
    "backdrop-filter",
    "blur",
    "webgl",
    "gta5"
  ],
  "author": "Murai (https://github.com/mur4i)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mur4i/mri-fivem-liquid-glass.git"
  },
  "homepage": "https://mur4i.github.io/mri-fivem-liquid-glass/",
  "bugs": {
    "url": "https://github.com/mur4i/mri-fivem-liquid-glass/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/mur4i"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43"
  }
}
